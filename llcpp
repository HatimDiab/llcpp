#!/usr/bin/env python3
"""llcpp — an ollama-style CLI for llama.cpp.

    llcpp pull  unsloth/Qwen3.8-27B-GGUF:Q6
    llcpp run   qwen3.8-27b
    llcpp list
    llcpp rm    qwen3.8-27b

Models live under $LLAMA_CACHE (default ~/.cache/llama.cpp). Stdlib only.

What this does that `ollama` does not: it detects a repo's MTP head and wires up
`--spec-type draft-mtp` automatically, detects `mmproj-*` for vision, and follows
split GGUF shards. No wrapper process sits between you and llama-server.
"""
from __future__ import annotations

import sys

# The Homebrew formula ships this with a `/usr/bin/env python3` shebang, so the
# interpreter is whatever is first on PATH — which may be older than we need.
if sys.version_info < (3, 9):
    sys.stderr.write(
        "llcpp needs Python 3.9 or newer; this is %d.%d (%s).\n"
        "Point it at a newer interpreter, e.g.:  python3.13 %s\n"
        % (sys.version_info[0], sys.version_info[1], sys.executable, sys.argv[0])
    )
    raise SystemExit(1)

import argparse
import errno
import http.client
import json
import math
import os
import re
import shutil
import signal
import socket
import ssl
import subprocess
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

HF_API = "https://huggingface.co/api"
HF_RESOLVE = "https://huggingface.co/{repo}/resolve/main/{path}"
DEFAULT_QUANT = "Q4_K_M"          # same default as ollama and `llama-server -hf`
DEFAULT_CTX = 32768
PORT_BASE = 8080
FREE_SPACE_FLOOR = 10 * 1024**3   # refuse a pull that would leave less than this
MAX_RETRIES = 8                   # consecutive attempts that move zero bytes
__version__ = "0.4.0"
UA = {"User-Agent": "llcpp/" + __version__}

# Quant tokens as they appear in GGUF filenames: Q4_K_M, UD-Q6_K_XL, IQ2_XXS, BF16...
QUANT_RE = re.compile(r"(?:UD-)?(?:IQ\d+(?:_[A-Z0-9]+)*|Q\d+(?:_[A-Z0-9]+)*|BF16|F16|F32)", re.I)
SHARD_RE = re.compile(r"^(?P<stem>.+)-(?P<idx>\d{5})-of-(?P<total>\d{5})\.gguf$", re.I)


# ---------------------------------------------------------------- presentation

def _tty() -> bool:
    return sys.stderr.isatty()


class C:
    if os.environ.get("NO_COLOR") or not sys.stdout.isatty():
        BOLD = DIM = RED = GRN = YLW = BLU = OFF = ""
    else:
        BOLD, DIM = "\033[1m", "\033[2m"
        RED, GRN, YLW, BLU = "\033[31m", "\033[32m", "\033[33m", "\033[34m"
        OFF = "\033[0m"


def human(n: float) -> str:
    # Decimal units, to match the sizes Hugging Face reports for the same files.
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1000 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000
    return f"{n:.1f} TB"


def human_ram(n: float) -> str:
    return f"{n / 1024**3:.0f} GB"


def ago(iso: str) -> str:
    try:
        then = datetime.fromisoformat(iso)
    except ValueError:
        return "unknown"
    secs = (datetime.now(timezone.utc) - then).total_seconds()
    for limit, div, name in ((60, 1, "second"), (3600, 60, "minute"),
                             (86400, 3600, "hour"), (2592000, 86400, "day"),
                             (31536000, 2592000, "month")):
        if secs < limit:
            v = int(secs / div) or 1
            return f"{v} {name}{'s' if v != 1 else ''} ago"
    v = int(secs / 31536000) or 1
    return f"{v} year{'s' if v != 1 else ''} ago"


def die(msg: str, code: int = 1) -> "NoReturn":  # noqa: F821
    print(f"{C.RED}error:{C.OFF} {msg}", file=sys.stderr)
    sys.exit(code)


def info(msg: str) -> None:
    print(msg, file=sys.stderr)


# ------------------------------------------------------------------- registry

def cache_root() -> Path:
    raw = os.environ.get("LLAMA_CACHE") or str(Path.home() / ".cache" / "llama.cpp")
    return Path(raw).expanduser()


def models_dir() -> Path:
    return cache_root() / "models"


def reg_path() -> Path:
    return cache_root() / "registry.json"


def load_reg() -> dict:
    try:
        with open(reg_path()) as fh:
            reg = json.load(fh)
    except (FileNotFoundError, json.JSONDecodeError):
        reg = {}
    reg.setdefault("models", {})
    reg.setdefault("servers", {})
    reg.setdefault("partials", {})
    return reg


def save_reg(reg: dict) -> None:
    reg_path().parent.mkdir(parents=True, exist_ok=True)
    tmp = reg_path().with_suffix(".json.tmp")
    with open(tmp, "w") as fh:
        json.dump(reg, fh, indent=2, sort_keys=True)
    tmp.replace(reg_path())


def hf_token() -> "str | None":
    tok = os.environ.get("HF_TOKEN")
    if tok:
        return tok.strip()
    home = os.environ.get("HF_HOME") or str(Path.home() / ".cache" / "huggingface")
    try:
        return (Path(home) / "token").read_text().strip() or None
    except OSError:
        return None


# ----------------------------------------------------------------- HF client

def hf_get(url: str) -> object:
    headers = dict(UA)
    tok = hf_token()
    if tok:
        headers["Authorization"] = f"Bearer {tok}"
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        if e.code == 401:
            die("Hugging Face returned 401. The repo is gated — accept its terms and "
                "set HF_TOKEN (or log in so a token exists under $HF_HOME/token).")
        if e.code == 404:
            die(f"not found on Hugging Face: {url.split('/models/')[-1].split('/tree')[0]}")
        die(f"Hugging Face API error {e.code}: {e.reason}")
    except urllib.error.URLError as e:
        die(f"cannot reach Hugging Face: {e.reason}")


def repo_files(repo: str) -> "list[dict]":
    """Every file in the repo, including subdirectories (MTP/, BF16/ shards)."""
    data = hf_get(f"{HF_API}/models/{repo}/tree/main?recursive=true")
    out = []
    for e in data:  # type: ignore[union-attr]
        if e.get("type") != "file":
            continue
        size = e.get("lfs", {}).get("size") or e.get("size") or 0
        out.append({"path": e["path"], "size": size})
    return out


def hf_search(query: str, limit: int = 5) -> "list[dict]":
    q = urllib.parse.quote(query)
    url = f"{HF_API}/models?search={q}&filter=gguf&sort=downloads&direction=-1&limit={limit}"
    return hf_get(url)  # type: ignore[return-value]


def hf_quicksearch(query: str, limit: int = 10) -> "list[dict]":
    """Second retrieval channel — more forgiving than ?search=, but no metadata."""
    q = urllib.parse.quote(query)
    try:
        with urllib.request.urlopen(urllib.request.Request(
                f"https://huggingface.co/api/quicksearch?q={q}&type=model",
                headers=UA), timeout=20) as r:
            out = json.load(r).get("models", [])
    except Exception:
        return []
    return [{"id": m["id"], "downloads": 0} for m in out[:limit]]


def retrieve(queries: "list[str]", per_query: int) -> "list[dict]":
    """Union several lexical probes across both HF search endpoints."""
    import concurrent.futures as cf
    found: "dict[str, dict]" = {}
    jobs = []
    with cf.ThreadPoolExecutor(max_workers=8) as pool:
        for q in queries:
            jobs.append(pool.submit(hf_search, q, per_query))
            jobs.append(pool.submit(hf_quicksearch, q, per_query))
        for fut in cf.as_completed(jobs):
            try:
                res = fut.result()
            except Exception:
                continue
            for m in res or []:
                cur = found.get(m["id"])
                # ?search= carries download counts; quicksearch does not. Keep the
                # richer record when the same repo arrives from both.
                if not cur or (m.get("downloads", 0) > cur.get("downloads", 0)):
                    found[m["id"]] = m
    return list(found.values())


# ------------------------------------------------------- name/quant resolution

def quant_token(path: str) -> "str | None":
    """Pull the quant label out of a GGUF filename, e.g. UD-Q6_K_XL."""
    name = Path(path).name
    m = SHARD_RE.match(name)
    if m:
        name = m.group("stem") + ".gguf"
    hits = QUANT_RE.findall(name[: -len(".gguf")] if name.endswith(".gguf") else name)
    if not hits:
        return None
    # findall with a non-capturing pattern returns whole matches; take the last.
    return hits[-1].upper()


def _bare(q: str) -> str:
    q = q.upper()
    return q[3:] if q.startswith("UD-") else q


def score_quant(cand: str, want: str) -> int:
    """Higher is better; -1 means incompatible."""
    c, w = _bare(cand), _bare(want)
    if c == w:
        s = 100
    elif c.startswith(w):
        s = 80 - (len(c) - len(w))
    elif w in c:
        s = 60 - (len(c) - len(w))
    else:
        return -1
    if cand.upper().startswith("UD-"):
        s += 5  # unsloth dynamic quants beat plain ones at the same size
    return s


def is_aux(path: str) -> bool:
    n = Path(path).name.lower()
    return (n.startswith("mmproj") or n.startswith("imatrix")
            or "/mtp" in path.lower() or n.startswith("mtp-"))


def pick_weights(files: "list[dict]", want: str) -> "list[dict]":
    """Choose the main weight file(s) for a quant, following split shards."""
    cands = {}
    for f in files:
        p = f["path"]
        if not p.lower().endswith(".gguf") or is_aux(p):
            continue
        q = quant_token(p)
        if not q:
            continue
        sc = score_quant(q, want)
        if sc < 0:
            continue
        cands.setdefault(q, {"score": sc, "files": []})
        cands[q]["files"].append(f)

    if not cands:
        avail = sorted({quant_token(f["path"]) or "?" for f in files
                        if f["path"].lower().endswith(".gguf") and not is_aux(f["path"])})
        die(f"no quant matching {want!r}. Available: {', '.join(avail)}")

    best = max(cands.items(), key=lambda kv: (kv[1]["score"], -len(kv[0])))
    picked = sorted(best[1]["files"], key=lambda f: f["path"])
    return picked


def pick_mtp(files: "list[dict]") -> "dict | None":
    for f in files:
        n = Path(f["path"]).name.lower()
        if n.startswith("mtp-") or "/mtp" in f["path"].lower():
            if n.endswith(".gguf"):
                return f
    return None


def pick_mmproj(files: "list[dict]") -> "dict | None":
    cands = [f for f in files if Path(f["path"]).name.lower().startswith("mmproj")]
    if not cands:
        return None
    # F16 is the safer choice on the Metal backend than BF16. Compare whole quant
    # tokens, not substrings — "f16" is a substring of "bf16".
    order = {"F16": 0, "BF16": 1, "F32": 2}
    return sorted(cands, key=lambda f: (order.get(quant_token(f["path"]) or "", 9),
                                        f["path"]))[0]


def short_name(repo: str, quant: str) -> str:
    base = repo.split("/")[-1]
    base = re.sub(r"[-_]?GGUF$", "", base, flags=re.I)
    return f"{base.lower()}:{quant.lower()}"


def resolve_ref(ref: str, reg: dict, assume_yes: bool = False) -> "tuple[str, str]":
    """Turn user input into (repo, quant)."""
    if ":" in ref and "/" in ref.split(":")[0]:
        repo, quant = ref.rsplit(":", 1)
        return repo, quant
    if "/" in ref:
        return ref, DEFAULT_QUANT

    # Bare name: an already-pulled model wins, then fall back to HF search.
    matches = [n for n in reg["models"] if n == ref or n.split(":")[0] == ref.split(":")[0]]
    if ":" in ref:
        matches = [n for n in matches if n == ref]
    if len(matches) == 1:
        m = reg["models"][matches[0]]
        return m["repo"], m["quant"]
    if len(matches) > 1:
        die(f"{ref!r} is ambiguous: {', '.join(sorted(matches))}")

    name, quant = (ref.split(":", 1) + [DEFAULT_QUANT])[:2]
    info(f"{C.DIM}searching Hugging Face for {name!r}…{C.OFF}")
    hits = hf_search(name)
    if not hits:
        die(f"no GGUF repo found for {name!r}. Pass an explicit org/repo:quant.")
    repo = hits[0]["id"]
    if not assume_yes:
        others = ", ".join(h["id"] for h in hits[1:4])
        info(f"  → {C.BOLD}{repo}{C.OFF}" + (f"{C.DIM}  (also: {others}){C.OFF}" if others else ""))
    return repo, quant


# ------------------------------------------------------------------ downloads

def _dur(secs: int) -> str:
    if secs >= 3600:
        return f"{secs // 3600}h{(secs % 3600) // 60:02d}m"
    return f"{secs // 60}m{secs % 60:02d}s"


def _fetch_once(url: str, dest: Path, total: int, label: str) -> "tuple[bool, int]":
    """One attempt. Returns (complete, bytes on disk). Raises on network error."""
    have = dest.stat().st_size if dest.exists() else 0
    if total and have >= total:
        return True, have

    headers = dict(UA)
    tok = hf_token()
    if tok:
        headers["Authorization"] = f"Bearer {tok}"
    if have:
        headers["Range"] = f"bytes={have}-"

    try:
        resp = urllib.request.urlopen(urllib.request.Request(url, headers=headers),
                                      timeout=60)
    except urllib.error.HTTPError as e:
        if e.code == 416 and total and have >= total:
            return True, have
        if e.code in (408, 429, 500, 502, 503, 504):
            raise ConnectionError(f"HTTP {e.code} {e.reason}")   # transient
        die(f"download failed ({e.code} {e.reason}): {label}")

    mode = "ab" if (have and resp.status == 206) else "wb"
    if mode == "wb":
        have = 0

    done, last = have, 0.0
    seg_start, seg_bytes = time.time(), 0
    with resp, open(dest, mode) as fh:
        while True:
            # read1 hands back whatever has arrived instead of blocking until a
            # full buffer is filled, so a reset mid-chunk keeps the bytes already
            # received rather than discarding up to a megabyte of them.
            chunk = resp.read1(1 << 20)
            if not chunk:
                break
            try:
                fh.write(chunk)
            except OSError as e:
                if e.errno == errno.ENOSPC:
                    die(f"out of disk space writing {label}")
                raise
            done += len(chunk)
            seg_bytes += len(chunk)
            now = time.time()
            if _tty() and (now - last > 0.2):
                last = now
                rate = seg_bytes / max(now - seg_start, 1e-6)
                pct = f"{done / total * 100:5.1f}%" if total else "  ?  "
                eta = f"  eta {_dur(int((total - done) / rate))}" if total and rate else ""
                sys.stderr.write(f"\r  {label[:38]:38s} {pct}  {human(done):>9s}"
                                 f"  {human(rate)}/s{eta}   ")
                sys.stderr.flush()
    return (done >= total if total else True), done


def download(url: str, dest: Path, total: int, label: str) -> None:
    """Resumable single-stream GET that survives a dropped connection.

    A multi-gigabyte transfer takes long enough that a mid-stream reset is
    routine rather than exceptional, so a dropped connection resumes instead of
    aborting the pull. Every attempt continues from what is already on disk via
    a Range request, so nothing already transferred is paid for twice.
    """
    dest.parent.mkdir(parents=True, exist_ok=True)
    if total and dest.exists() and dest.stat().st_size > total:
        dest.unlink()                       # stale or corrupt partial
    if total and dest.exists() and dest.stat().st_size == total:
        info(f"  {C.GRN}✓{C.OFF} {label} {C.DIM}(already complete){C.OFF}")
        return

    retryable = (ConnectionError, TimeoutError, socket.timeout, ssl.SSLError,
                 http.client.IncompleteRead, http.client.RemoteDisconnected,
                 http.client.BadStatusLine, urllib.error.URLError)
    start, stalls = time.time(), 0
    while True:
        before = dest.stat().st_size if dest.exists() else 0
        try:
            complete, done = _fetch_once(url, dest, total, label)
            if complete:
                if _tty():
                    sys.stderr.write("\r" + " " * 100 + "\r")
                info(f"  {C.GRN}✓{C.OFF} {label} "
                     f"{C.DIM}({human(done)} in {_dur(int(time.time() - start))}){C.OFF}")
                return
            raise ConnectionError("connection closed before the file was complete")
        except retryable as e:
            after = dest.stat().st_size if dest.exists() else 0
            # Progress means the link is flaky, not dead — keep going. Only
            # attempts that moved nothing count toward giving up.
            stalls = 0 if after > before else stalls + 1
            if _tty():
                sys.stderr.write("\r" + " " * 100 + "\r")
            if stalls > MAX_RETRIES:
                die(f"{label}: {e}\n"
                    f"  gave up after {MAX_RETRIES} attempts with no progress. "
                    f"{human(after)} is on disk — re-run the same pull to resume.")
            wait = min(2 ** max(stalls - 1, 0), 30)
            info(f"  {C.YLW}!{C.OFF} {label}: {e}{C.DIM} — resuming from "
                 f"{human(after)} in {wait}s{C.OFF}")
            time.sleep(wait)


# ------------------------------------------------------------ server lifecycle

def alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except OSError as e:
        return e.errno == errno.EPERM
    return True


def health(port: int, timeout: float = 2.0) -> bool:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=timeout) as r:
            return json.load(r).get("status") == "ok"
    except Exception:
        return False


def free_port(reg: dict) -> int:
    import socket
    used = {s["port"] for s in reg["servers"].values()}
    for p in range(PORT_BASE, PORT_BASE + 200):
        if p in used:
            continue
        with socket.socket() as s:
            try:
                s.bind(("127.0.0.1", p))
            except OSError:
                continue
        return p
    die("no free port in range 8080-8280")


def reap(reg: dict) -> dict:
    """Drop registry entries whose process is gone."""
    for name in list(reg["servers"]):
        if not alive(reg["servers"][name]["pid"]):
            del reg["servers"][name]
    return reg


def build_cmd(entry: dict, port: int, ctx: int, name: str, vision: bool = True) -> "list[str]":
    root = models_dir() / entry["dir"]
    cmd = ["llama-server", "-m", str(root / entry["main"])]
    if entry.get("mtp"):
        cmd += ["-md", str(root / entry["mtp"]),
                "--spec-type", "draft-mtp",
                "--spec-draft-n-max", "3", "--spec-draft-n-min", "1"]
    # llama-server disables prompt-cache reuse whenever an mmproj is loaded, which
    # is a bad trade for coding work that resends the same file context.
    if entry.get("mmproj") and vision:
        cmd += ["--mmproj", str(root / entry["mmproj"])]
    cmd += ["-a", name.split(":")[0],
            "-c", str(ctx), "-ngl", "99", "-fa", "on",
            "--cache-reuse", "256", "--jinja",
            "--reasoning-format", "deepseek",
            "--no-context-shift",
            "--host", "127.0.0.1", "--port", str(port)]
    return cmd


def ensure_server(name: str, reg: dict, ctx: int, port: "int | None" = None,
                  vision: bool = True) -> "tuple[int, dict]":
    reap(reg)
    entry = reg["models"].get(name)
    if not entry:
        die(f"model {name!r} is not pulled. Try: llcpp pull {name}")

    running = reg["servers"].get(name)
    if running and health(running["port"]):
        if port and running["port"] != port:
            die(f"{name} is already serving on port {running['port']}; "
                f"stop it first (llcpp stop {name}) to move it to {port}")
        return running["port"], reg

    port = port or free_port(reg)
    if not shutil.which("llama-server"):
        die("llama-server not on PATH. Install llama.cpp (brew install llama.cpp).")

    logs = cache_root() / "logs"
    logs.mkdir(parents=True, exist_ok=True)
    logf = logs / f"{name.replace('/', '_').replace(':', '_')}.log"
    cmd = build_cmd(entry, port, ctx, name, vision)

    extras = []
    if entry.get("mtp"):
        extras.append("MTP spec-decode")
    if entry.get("mmproj") and vision:
        extras.append("vision")
    elif entry.get("mmproj"):
        extras.append("no vision, cache-reuse on")
    suffix = f" {C.DIM}({', '.join(extras)}){C.OFF}" if extras else ""
    info(f"{C.DIM}starting {name} on :{port}{C.OFF}{suffix}")

    with open(logf, "ab") as fh:
        fh.write(f"\n=== {datetime.now(timezone.utc).isoformat()} :{port} ===\n".encode())
        fh.write((" ".join(cmd) + "\n").encode())
        proc = subprocess.Popen(cmd, stdout=fh, stderr=subprocess.STDOUT,
                                stdin=subprocess.DEVNULL, start_new_session=True)

    for _ in range(600):  # up to ~5 min for a cold, large model
        if proc.poll() is not None:
            tail = logf.read_text(errors="replace").splitlines()[-15:]
            die("llama-server exited during startup:\n  " + "\n  ".join(tail))
        if health(port, timeout=1.0):
            break
        time.sleep(0.5)
    else:
        proc.terminate()
        die(f"server did not become healthy; see {logf}")

    reg["servers"][name] = {"port": port, "pid": proc.pid,
                            "started": datetime.now(timezone.utc).isoformat(),
                            "ctx": ctx, "log": str(logf)}
    save_reg(reg)
    return port, reg


# ---------------------------------------------------------------- chat client

def stream_chat(port: int, messages: list, think: bool, max_tokens: int = 4096) -> dict:
    """Stream one completion; print as it arrives. Returns the assistant message."""
    body = {"model": "llcpp", "messages": messages, "stream": True,
            "max_tokens": max_tokens, "temperature": 0.6, "top_p": 0.95}
    if not think:
        body["chat_template_kwargs"] = {"enable_thinking": False}

    req = urllib.request.Request(
        f"http://127.0.0.1:{port}/v1/chat/completions",
        json.dumps(body).encode(), {"Content-Type": "application/json"})

    content, reasoning, in_think = [], [], False
    try:
        with urllib.request.urlopen(req, timeout=900) as resp:
            for raw in resp:
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                payload = line[5:].strip()
                if payload == "[DONE]":
                    break
                try:
                    delta = json.loads(payload)["choices"][0].get("delta", {})
                except (json.JSONDecodeError, KeyError, IndexError):
                    continue
                if delta.get("reasoning_content"):
                    if not in_think:
                        sys.stdout.write(f"{C.DIM}")
                        in_think = True
                    sys.stdout.write(delta["reasoning_content"])
                    reasoning.append(delta["reasoning_content"])
                if delta.get("content"):
                    if in_think:
                        sys.stdout.write(f"{C.OFF}\n")
                        in_think = False
                    sys.stdout.write(delta["content"])
                    content.append(delta["content"])
                sys.stdout.flush()
    except KeyboardInterrupt:
        sys.stdout.write(f"{C.OFF}\n{C.DIM}[interrupted]{C.OFF}\n")
    except urllib.error.URLError as e:
        die(f"request failed: {e.reason}")
    if in_think:
        sys.stdout.write(C.OFF)
    sys.stdout.write("\n")
    sys.stdout.flush()
    return {"role": "assistant", "content": "".join(content),
            "reasoning": "".join(reasoning)}


def repl(name: str, port: int) -> None:
    think = True
    messages: list = []
    print(f"{C.DIM}{name} on :{port} — /bye to exit, /? for commands{C.OFF}")
    while True:
        try:
            line = input(f"{C.BOLD}>>>{C.OFF} ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not line:
            continue
        if line in ("/bye", "/exit", "/quit"):
            return
        if line == "/?":
            print("  /bye            exit\n"
                  "  /clear          forget the conversation\n"
                  "  /think on|off   toggle reasoning\n"
                  "  /web            open the llama.cpp web UI")
            continue
        if line == "/clear":
            messages = []
            print(f"{C.DIM}context cleared{C.OFF}")
            continue
        if line.startswith("/think"):
            arg = line.split()[-1]
            think = arg != "off"
            print(f"{C.DIM}thinking {'on' if think else 'off'}{C.OFF}")
            continue
        if line == "/web":
            subprocess.run(["open", f"http://127.0.0.1:{port}"], check=False)
            continue
        messages.append({"role": "user", "content": line})
        reply = stream_chat(port, messages, think)
        messages.append({"role": "assistant", "content": reply["content"]})


# ----------------------------------------------------------- hardware profile

# Apple Silicon unified-memory bandwidth, GB/s. Only the entry for this machine
# (M5 Max) is vendor-confirmed; the rest are close enough to rank with. Override
# with LLCPP_BANDWIDTH if you know better.
BANDWIDTH_GBPS = {
    "M1": 68, "M1 PRO": 200, "M1 MAX": 400, "M1 ULTRA": 800,
    "M2": 100, "M2 PRO": 200, "M2 MAX": 400, "M2 ULTRA": 800,
    "M3": 100, "M3 PRO": 150, "M3 MAX": 400, "M3 ULTRA": 800,
    "M4": 120, "M4 PRO": 273, "M4 MAX": 546,
    "M5": 153, "M5 PRO": 307, "M5 MAX": 614, "M5 ULTRA": 1228,
}
DENSE_EFF = 0.70   # fraction of peak bandwidth a dense decode actually reaches
MOE_EFF = 0.55     # MoE pays routing overhead on top


def _sysctl(key: str) -> "str | None":
    try:
        out = subprocess.run(["sysctl", "-n", key], capture_output=True, text=True, timeout=5)
        return out.stdout.strip() or None
    except (OSError, subprocess.SubprocessError):
        return None


def hw_profile() -> dict:
    ram = 0
    chip = ""
    if sys.platform == "darwin":
        ram = int(_sysctl("hw.memsize") or 0)
        chip = _sysctl("machdep.cpu.brand_string") or ""
    else:
        try:
            for line in open("/proc/meminfo"):
                if line.startswith("MemTotal:"):
                    ram = int(line.split()[1]) * 1024
                    break
        except OSError:
            pass

    key = re.sub(r"^Apple\s+", "", chip).upper().strip()
    bw = float(os.environ.get("LLCPP_BANDWIDTH") or BANDWIDTH_GBPS.get(key, 0))

    # macOS caps GPU-addressable unified memory at ~75% unless iogpu is raised.
    wired_mb = int(_sysctl("iogpu.wired_limit_mb") or 0)
    vram = wired_mb * 1024**2 if wired_mb else int(ram * 0.75)
    return {"ram": ram, "chip": chip or "unknown", "bandwidth": bw, "vram": vram}


def budget_bytes(hw: dict, ctx_reserve: float = 0.15, floor: int = 3 * 1000**3) -> int:
    """Room for weights, leaving headroom for KV cache and compute buffers."""
    return max(int(hw["vram"] * (1 - ctx_reserve)) - floor, 0)


def active_ratio(name: str) -> float:
    """MoE models named like 30B-A3B only stream their active params per token."""
    m = re.search(r"(\d+(?:\.\d+)?)B[-_]?A(\d+(?:\.\d+)?)B", name, re.I)
    if m:
        total, active = float(m.group(1)), float(m.group(2))
        if total > 0:
            return min(max(active / total, 0.02), 1.0)
    return 1.0


def est_tps(size: int, ratio: float, bw: float) -> "float | None":
    """Decode is memory-bandwidth bound: tok/s ~= bandwidth / bytes-read-per-token."""
    if not bw or not size:
        return None
    eff = DENSE_EFF if ratio >= 0.999 else MOE_EFF
    gb = (size / 1e9) * ratio
    return bw / max(gb, 0.05) * eff


