    sp.set_defaults(func=cmd_pull)

    sr = _sp(sub, "run", "chat with a model (pulls and starts it if needed)", """
examples:
  llcpp run qwen3.8-27b                      interactive chat
  llcpp run qwen3.8-27b "explain this regex" one-shot, prints and exits
  git diff | llcpp run qwen3.8-27b           reads a piped prompt from stdin
  llcpp run qwen3.8-27b --no-think           skip reasoning, much faster edits

Starts the server if it is not already up, and reuses it if it is. The server
outlives the command; stop it with `llcpp stop`.

In the REPL: /bye to exit, /clear to forget the conversation, /think on|off,
/web to open llama.cpp's browser UI, /? for the list.
""")
    sr.add_argument("model")
