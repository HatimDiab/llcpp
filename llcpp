def cmd_list(args: argparse.Namespace) -> None:
    reg = reap(load_reg())
    save_reg(reg)
    partials = reg.get("partials", {})
    stale = [n for n, d in partials.items()
             if n in reg["models"] or bytes_on_disk(d["repo"], d["files"]) == 0]
    for n in stale:
        del partials[n]
    if stale:
        save_reg(reg)
    if not reg["models"] and not partials:
        print("no models. Try: llcpp pull unsloth/Qwen3.8-27B-GGUF:Q6")
        return
    rows = []
    for name, m in sorted(reg["models"].items()):
        srv = reg["servers"].get(name)
        status = f"{C.GRN}:{srv['port']}{C.OFF}" if srv else f"{C.DIM}—{C.OFF}"
        feats = ",".join(filter(None, [
            "mtp" if m.get("mtp") else "",
            "vision" if m.get("mmproj") else "",
        ])) or "—"
        rows.append((name, m["quant"], human(m["bytes"]), feats,
                     ago(m["pulled_at"]), status))
    widths = [max(len(str(r[i])) for r in rows + [("NAME", "QUANT", "SIZE", "FEATURES", "PULLED", "")])
              for i in range(5)]
    hdr = ("NAME", "QUANT", "SIZE", "FEATURES", "PULLED", "SERVING")
    print(C.BOLD + "  ".join(h.ljust(widths[i]) for i, h in enumerate(hdr[:5]))
          + "  " + hdr[5] + C.OFF)
    for r in rows:
        print("  ".join(str(r[i]).ljust(widths[i]) for i in range(5)) + "  " + r[5])

    if partials:
        print(f"\n{C.YLW}unfinished{C.OFF}")
        for name, d in sorted(partials.items()):
            done = bytes_on_disk(d["repo"], d["files"])
            pct = done / d["total"] * 100 if d["total"] else 0
            print(f"  {name}  {C.DIM}{human(done)} of {human(d['total'])} "
                  f"({pct:.1f}%), stopped {ago(d['updated'])}{C.OFF}")
        first = sorted(partials.items())[0][1]
        print(f"{C.DIM}  resume: llcpp pull {first['repo']}:{first['quant']}{C.OFF}")


def cmd_ps(args: argparse.Namespace) -> None:
    reg = reap(load_reg())
    save_reg(reg)
    if not reg["servers"]:
        print("no running servers")
        return
    print(f"{C.BOLD}{'NAME':28s} {'PORT':>5s} {'PID':>7s} {'CTX':>7s}  UPTIME{C.OFF}")
    for name, s in sorted(reg["servers"].items()):
        print(f"{name:28s} {s['port']:>5d} {s['pid']:>7d} {s.get('ctx', 0):>7d}  "
              f"{ago(s['started']).replace(' ago', '')}")


def cmd_stop(args: argparse.Namespace) -> None:
    reg = reap(load_reg())
    targets = list(reg["servers"]) if args.all else [
        _match_local(m, reg, autopull=False) for m in args.model]
    if not targets:
        die("nothing to stop (pass a model name or --all)")
    for name in targets:
        s = reg["servers"].get(name)
        if not s:
            info(f"{C.DIM}{name} is not running{C.OFF}")
            continue
        try:
            os.kill(s["pid"], signal.SIGTERM)
        except OSError:
            pass
        for _ in range(40):
            if not alive(s["pid"]):
                break
            time.sleep(0.25)
        else:
            try:
                os.kill(s["pid"], signal.SIGKILL)
            except OSError:
                pass
        del reg["servers"][name]
        info(f"{C.GRN}stopped{C.OFF} {name}")
    save_reg(reg)


def cmd_rm(args: argparse.Namespace) -> None:
    reg = reap(load_reg())
    for ref in args.model:
        part = next((n for n in reg.get("partials", {})
                     if n == ref or n.split(":")[0] == ref.split(":")[0]), None)
        if part and part not in reg["models"]:
            d = reg["partials"][part]
            freed = discard_partial(d["repo"], d["files"])
            clear_partial(part)
            info(f"{C.GRN}removed{C.OFF} unfinished {part} "
                 f"{C.DIM}({human(freed)} freed){C.OFF}")
            continue
        name = _match_local(ref, reg, autopull=False)
        entry = reg["models"][name]

        if name in reg["servers"]:
            info(f"{C.DIM}stopping {name} first{C.OFF}")
            try:
                os.kill(reg["servers"][name]["pid"], signal.SIGTERM)
                time.sleep(1)
            except OSError:
                pass
            del reg["servers"][name]

        root = models_dir() / entry["dir"]
        # Other quants may share this repo directory — only remove our own files.
        mine = [entry["main"], entry.get("mtp"), entry.get("mmproj")] + entry.get("shards", [])
        siblings = [n for n, m in reg["models"].items()
                    if n != name and m["dir"] == entry["dir"]]
        keep = set()
        for s in siblings:
            o = reg["models"][s]
            keep.update(filter(None, [o["main"], o.get("mtp"), o.get("mmproj")] + o.get("shards", [])))

        freed = 0
        for rel in filter(None, dict.fromkeys(mine)):
            if rel in keep:
                continue
            p = root / rel
            if p.exists():
                freed += p.stat().st_size
                p.unlink()
        if not siblings and root.exists():
            shutil.rmtree(root, ignore_errors=True)
            parent = root.parent
            try:
                parent.rmdir()  # drop the org dir if it is now empty
            except OSError:
                pass

        del reg["models"][name]
        reg.setdefault("partials", {}).pop(name, None)
        save_reg(reg)
        info(f"{C.GRN}removed{C.OFF} {name} {C.DIM}({human(freed)} freed){C.OFF}")


def cmd_search(args: argparse.Namespace) -> None:
    import concurrent.futures as cf

    raw = " ".join(args.query).strip()
    if not raw:
        die("nothing to search for")

    hw = hw_profile()
    terms, cons = parse_query(raw)
    port = None
    queries = []
    if args.llm:
        reg = reap(load_reg())
        srv = next(iter(reg["servers"].values()), None)
        if not srv:
            info(f"{C.DIM}--llm needs a running server; falling back to heuristics{C.OFF}")
        else:
            port = srv["port"]
            got = llm_expand(raw, port)
            if got:
                queries = got[0]
                cons = {**cons, **got[1]}
                if queries:
                    info(f"{C.DIM}expanded to {', '.join(repr(q) for q in queries)}{C.OFF}")
            else:
                info(f"{C.DIM}local model gave no usable expansion; using heuristics{C.OFF}")
    if not terms:
        terms = raw
    if cons.get("inferred_family"):
        info(f"{C.DIM}no model named — inferring family {cons['inferred_family']!r} "
             f"from intent{C.OFF}")

    budget = args.vram * 1000**3 if args.vram else budget_bytes(hw)
    if cons.get("max_bytes"):
        budget = min(budget, cons["max_bytes"])
    prefer = cons.get("prefer", "quality")

    bw = f"~{hw['bandwidth']:.0f} GB/s" if hw["bandwidth"] else "unknown bandwidth"
    info(f"{C.DIM}{hw['chip']} · {human_ram(hw['ram'])} unified · {bw} · "
         f"weight budget {human(budget)}{C.OFF}")
    info(f"{C.DIM}query {terms!r}"
         + (f" · {', '.join(f'{k}={v}' for k, v in cons.items() if k not in ('max_bytes', 'inferred_family'))}"
            if any(k not in ('max_bytes', 'inferred_family') for k in cons) else "")
         + f"{C.OFF}")

    # Retrieval is lexical: HF matches repo names, so a sentence returns nothing.
    # Probe with the heuristic terms plus any model-suggested variants, and shorten
    # the heuristic phrase until it matches rather than failing on a long one.
    per_q = max(args.limit * 2, 12)
    hits = retrieve(queries, per_q) if queries else []
    words = terms.split()
    for n in range(len(words), 0, -1):
        probe = " ".join(words[:n])
        extra = retrieve([probe], per_q)
        if extra:
            if probe != terms:
                info(f"{C.DIM}narrowed heuristic query to {probe!r}{C.OFF}")
                terms = probe
            seen_ids = {h["id"] for h in hits}
            hits += [e for e in extra if e["id"] not in seen_ids]
            break
    if not hits:
        die(f"no GGUF repos matched {terms!r}")
    if len(hits) > 40:  # cap the enrichment fan-out
        hits = sorted(hits, key=lambda h: h.get("downloads", 0), reverse=True)[:40]

    rows: "list[dict]" = []
    enriched: "dict[str, dict]" = {}
    with cf.ThreadPoolExecutor(max_workers=8) as pool:
        futures = {pool.submit(enrich_repo, h["id"]): h for h in hits}
        for fut in cf.as_completed(futures):
            h = futures[fut]
            meta = fut.result()
            if not meta:
                continue
            enriched[h["id"]] = meta
            if cons.get("vision") and not meta["vision"]:
                continue
            if cons.get("mtp") and not meta["mtp"]:
                continue
            pick = choose_quant(meta["quants"], budget, prefer)
            if not pick and not args.all:
                continue
            quant, size = pick or min(meta["quants"].items(), key=lambda kv: kv[1])
            ratio = active_ratio(h["id"])
            rows.append({
                "repo": h["id"], "quant": quant, "size": size,
                "tps": est_tps(size, ratio, hw["bandwidth"]),
                "moe": ratio < 0.999, "mtp": meta["mtp"], "vision": meta["vision"],
                "downloads": h.get("downloads", 0), "fits": bool(pick),
            })

    if not rows and budget < budget_bytes(hw):
        # A parsed size cap (especially one an LLM invented) should not be fatal.
        info(f"{C.YLW}nothing fit in {human(budget)} — widening to this machine's "
             f"{human(budget_bytes(hw))}{C.OFF}")
        budget = budget_bytes(hw)
        for h in hits:
            meta = enriched.get(h["id"])
            if not meta:
                continue
            if cons.get("vision") and not meta["vision"]:
                continue
            pick = choose_quant(meta["quants"], budget, prefer)
            if not pick:
                continue
            ratio = active_ratio(h["id"])
            rows.append({
                "repo": h["id"], "quant": pick[0], "size": pick[1],
                "tps": est_tps(pick[1], ratio, hw["bandwidth"]),
                "moe": ratio < 0.999, "mtp": meta["mtp"], "vision": meta["vision"],
                "downloads": h.get("downloads", 0), "fits": True,
            })
    if not rows:
        die(f"nothing matching {terms!r} fits in {human(budget)}. "
            f"Try --all, --vram N, or different keywords.")

    for r in rows:
        tps = r["tps"] or 0
        speed_term = 0.0
        if tps:
            speed_term = 0.6 if tps >= 25 else (0.0 if tps >= 12 else -1.5)
        r["score"] = (math.log10(r["downloads"] + 10)
                      + (0.8 if r["mtp"] else 0)
                      + (0.4 if r["vision"] and cons.get("vision") else 0)
                      + speed_term
                      + (0.0 if r["fits"] else -3.0))
    rows.sort(key=lambda r: r["score"], reverse=True)

    # quicksearch returns no download counts; backfill the survivors so ranking
    # and the reranker both see real popularity numbers.
    missing = [r for r in rows[:25] if not r["downloads"]]
    if missing:
        def _dl(repo):
            try:
                return repo, (hf_get(f"{HF_API}/models/{repo}") or {}).get("downloads", 0)
            except SystemExit:
                return repo, 0
            except Exception:
                return repo, 0
        with cf.ThreadPoolExecutor(max_workers=8) as pool:
            for repo, dl in pool.map(_dl, [r["repo"] for r in missing]):
                for r in missing:
                    if r["repo"] == repo:
                        r["downloads"] = dl or 0
        for r in rows:
            tps = r["tps"] or 0
            speed_term = 0.0 if not tps else (0.6 if tps >= 25 else (0.0 if tps >= 12 else -1.5))
            r["score"] = (math.log10(r["downloads"] + 10) + (0.8 if r["mtp"] else 0)
                          + (0.4 if r["vision"] and cons.get("vision") else 0)
                          + speed_term + (0.0 if r["fits"] else -3.0))
        rows.sort(key=lambda r: r["score"], reverse=True)

    # Stage 2: let the local model judge a shortlist it can actually see. Picking
    # among concrete candidates is a far easier task than inventing keywords.
    reasons: "dict[int, str]" = {}
    if port and not args.no_rerank:
        shortlist = rows[:15]
        info(f"{C.DIM}reranking {len(shortlist)} candidates with the local model…{C.OFF}")
        rr = llm_rerank(raw, shortlist, port)
        if rr:
            ordered = [shortlist[i] for i in rr["order"]]
            rest = [r for r in rows if r not in ordered]
            for pos, idx in enumerate(rr["order"]):
                if idx in rr["reasons"]:
                    reasons[pos] = rr["reasons"][idx]
            rows = ordered + rest
        else:
            info(f"{C.DIM}rerank produced nothing usable; keeping heuristic order{C.OFF}")

    rows = rows[:args.limit]

    if args.json:
        print(json.dumps(rows, indent=2))
        return

    print()
    hdr = f"{'MODEL':52s} {'QUANT':12s} {'SIZE':>9s} {'~TOK/S':>7s}  {'FLAGS':14s} PULLS"
    print(C.BOLD + hdr + C.OFF)
    for i, r in enumerate(rows):
        flags = ",".join(filter(None, [
            "mtp" if r["mtp"] else "", "vision" if r["vision"] else "",
            "moe" if r["moe"] else ""])) or "—"
        tps = f"{r['tps']:.0f}" if r["tps"] else "?"
        dl = r["downloads"]
        dls = f"{dl/1e6:.1f}M" if dl >= 1e6 else (f"{dl/1e3:.0f}k" if dl >= 1e3 else str(dl))
        mark = "" if r["fits"] else f" {C.YLW}(over budget){C.OFF}"
        print(f"{r['repo'][:52]:52s} {r['quant'][:12]:12s} {human(r['size']):>9s} "
              f"{tps:>7s}  {flags:14s} {dls}{mark}")
        if i in reasons:
            print(f"{C.DIM}    ↳ {reasons[i]}{C.OFF}")

    top = rows[0]
    print(f"\n{C.DIM}tok/s is a bandwidth estimate"
          + (", conservative for MoE" if any(r["moe"] for r in rows) else "")
          + f"; MTP roughly doubles it.{C.OFF}")
    print(f"{C.BOLD}llcpp pull {top['repo']}:{top['quant']}{C.OFF}")

    if not args.no_docker:
        dk = search_docker(terms, limit=3)
        if dk:
            print(f"\n{C.DIM}also on Docker Hub ai/ (llama-server -dr):{C.OFF}")
            for repo in dk:
                tags = [t for t in docker_tags(repo["name"])
                        if t.get("full_size", 0) <= budget and t["name"] != "latest"]
                best = max(tags, key=lambda t: t["full_size"], default=None)
                if best:
                    print(f"  ai/{repo['name']}:{best['name']}  "
                          f"{C.DIM}{human(best['full_size'])}{C.OFF}")


def _match_local(ref: str, reg: dict, autopull: bool) -> str:
    """Map a user-typed name onto exactly one pulled model."""
    if ref in reg["models"]:
        return ref
    base = ref.split(":")[0]
    matches = [n for n in reg["models"] if n.split(":")[0] == base]
    if ":" in ref:
        matches = [n for n in matches if n == ref]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        die(f"{ref!r} is ambiguous — be specific: {', '.join(sorted(matches))}")
    if not autopull:
        die(f"model {ref!r} is not pulled. See: llcpp list")

    info(f"{C.DIM}{ref} not found locally — pulling{C.OFF}")
    ns = argparse.Namespace(model=ref, no_mtp=False, no_vision=False, yes=True,
                            resume=True, restart=False)
    cmd_pull(ns)
    reg2 = load_reg()
    matches = [n for n in reg2["models"] if n.split(":")[0] == base]
    if not matches:
        die(f"pull succeeded but {ref!r} still not registered")
    return matches[0]


