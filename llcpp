def _help(parser: argparse.ArgumentParser, sub: "argparse._SubParsersAction",
          topic: "str | None") -> None:
    if not topic:
        print(OVERVIEW.rstrip())
        return
    target = sub.choices.get(topic)
    if target:
        target.print_help()
        return
    if topic in TOPICS:
        print(TOPICS[topic].rstrip())
        return
    known = ", ".join(sorted(list(sub.choices) + list(TOPICS)))
    die(f"no such command or topic: {topic!r}\n  known: {known}")


def _sp(sub: "argparse._SubParsersAction", name: str, help_: str, epilog: str):
    return sub.add_parser(name, help=help_, epilog=epilog,
                          formatter_class=argparse.RawDescriptionHelpFormatter)


def main() -> None:
    p = argparse.ArgumentParser(
        prog="llcpp", description="ollama-style CLI for llama.cpp",
        epilog="models live under $LLAMA_CACHE (%s)" % cache_root())
    p.add_argument("-V", "--version", action="version",
                   version=f"llcpp {__version__}")
    sub = p.add_subparsers(dest="cmd", metavar="<command>")

    sp = _sp(sub, "pull", "download a model from Hugging Face", """
examples:
  llcpp pull unsloth/Qwen3.8-27B-GGUF:Q6_K_XL   an exact quant
  llcpp pull unsloth/Qwen3.8-27B-GGUF:Q6        fuzzy, picks the best Q6
  llcpp pull unsloth/Qwen3.8-27B-GGUF           defaults to Q4_K_M
  llcpp pull qwen3-coder                        searches Hugging Face by name

An MTP head and a vision encoder are fetched too when the repo has them; see
`llcpp help mtp`. Split shards are followed automatically. Downloads resume,
so re-run the same command after an interruption. See also `llcpp help refs`
and `llcpp help quants`.
""")
    sp.add_argument("model", help="org/repo:quant, or a bare name to search for")
    sp.add_argument("--no-mtp", action="store_true", help="skip the MTP speculative-decode head")
    sp.add_argument("--no-vision", action="store_true", help="skip the mmproj vision encoder")
    sp.add_argument("-y", "--yes", action="store_true",
                    help="accept defaults without prompting")
    sp.add_argument("--resume", action="store_true",
                    help="continue an unfinished download without asking")
