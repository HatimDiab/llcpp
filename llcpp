    prompt = " ".join(args.prompt).strip() if args.prompt else ""
    if not prompt and not sys.stdin.isatty():
        prompt = sys.stdin.read().strip()
    if prompt:
        stream_chat(port, [{"role": "user", "content": prompt}], not args.no_think)
        return
    repl(name, port)


