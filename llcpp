SIZE_RE = re.compile(
    r"(?:under|below|less\s+than|max(?:imum)?|at\s+most|within|fits?\s*(?:in|into|on)?|<=?|~)?"
    r"\s*(\d+(?:\.\d+)?)\s*(gb|gib|g|tb)\b", re.I)
SYNONYMS = {"coding": "coder", "code": "coder", "programming": "coder",
            "vision": "vl", "multimodal": "vl", "image": "vl",
            "embedding": "embed", "embeddings": "embed", "rerank": "reranker"}
STOPWORDS = set("""a an the for that which with of to in on my me i we want need find show
me best good great fastest fast small smallest big biggest large largest quality
model models llm llms gguf quant quants run runs running local locally hardware
machine mac macbook ram memory unified and or is are can could would something
please give recommend suggest what whats about like most least than then use using
under below over above within fits fit at must be should will editor ide
autocomplete completion assistant chat chatbot task tasks work working help
quick snappy responsive latency thing stuff one some any""".split())


# Hugging Face search is keyword-based, not semantic. When a request describes a
# job but names no model, steer it at a family known to do that job well. These
# are starting points, not verdicts — the ranking still decides.
INTENT_HINTS = [
    (r"\b(autocomplete|fim|fill[- ]in[- ]the[- ]middle|inline)\b", "qwen2.5-coder"),
    (r"\b(coder|refactor|debug|repo)\b", "qwen3-coder"),
    (r"\b(vl|screenshot|diagram|ocr)\b", "qwen3-vl"),
    (r"\b(embed|rag|retrieval|semantic)\b", "embeddinggemma"),
    (r"\b(reason|reasoning|think|thinking|math|proof)\b", "qwen3"),
    (r"\b(translate|translation|multilingual)\b", "gemma"),
    (r"\b(agent|agentic|tool|tools)\b", "qwen3-coder"),
]


def parse_query(q: str) -> "tuple[str, dict]":
    """Heuristically split free text into search terms plus hard constraints."""
    ql = " " + q.lower().strip() + " "
    cons: dict = {}

    m = SIZE_RE.search(ql)
    if m:
        val = float(m.group(1))
        unit = m.group(2).lower()
        cons["max_bytes"] = int(val * (1000**4 if unit == "tb" else 1000**3))
        ql = ql[:m.start()] + " " + ql[m.end():]

    if re.search(r"\b(vision|multimodal|image|images|screenshot|vlm|see)\b", ql):
        cons["vision"] = True
    if re.search(r"\b(mtp|speculative|draft)\b", ql):
        cons["mtp"] = True
    if re.search(r"\b(fast|fastest|quick|snappy|low[- ]?latency|responsive)\b", ql):
        cons["prefer"] = "speed"
    elif re.search(r"\b(best|smartest|strongest|highest[- ]?quality|most capable)\b", ql):
        cons["prefer"] = "quality"

    words = re.sub(r"[^\w.+-]+", " ", ql).split()
    terms = [SYNONYMS.get(w, w) for w in words if w not in STOPWORDS]
    # de-dupe, keep order
    seen, out = set(), []
    for t in terms:
        if t not in seen:
            seen.add(t)
            out.append(t)
    if not out:
        for pat, family in INTENT_HINTS:
            if re.search(pat, ql):
                out = [family]
                cons["inferred_family"] = family
                break
    return " ".join(out), cons


def _ask_local(port: int, prompt: str, max_tokens: int) -> "str | None":
    body = {"model": "llcpp", "messages": [{"role": "user", "content": prompt}],
            "max_tokens": max_tokens, "temperature": 0.0,
            "chat_template_kwargs": {"enable_thinking": False}}
    try:
        req = urllib.request.Request(f"http://127.0.0.1:{port}/v1/chat/completions",
                                     json.dumps(body).encode(),
                                     {"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=180) as r:
            return json.load(r)["choices"][0]["message"]["content"]
    except Exception:
        return None


def _json_blob(txt: "str | None") -> "dict | None":
    if not txt:
        return None
    m = re.search(r"\{.*\}", txt, re.S)
    if not m:
        return None
    try:
        return json.loads(m.group(0))
    except json.JSONDecodeError:
        return None


def llm_expand(q: str, port: int) -> "tuple[list, dict] | None":
    """Stage 1: turn a request into several lexical queries plus constraints.

    Hugging Face search matches on repo names only, so a whole sentence returns
    nothing. Several short guesses beat one, and wrong ones cost only a request.
    """
    prompt = (
        "You are helping search Hugging Face for GGUF model repos. Repo names look "
        "like 'unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF'. Search matches NAMES ONLY, "
        "so queries must be short model-name fragments, never sentences.\n"
        'Return JSON: {"queries": ["q1","q2","q3"], "max_gb": <number or null>, '
        '"vision": <true|false>, "prefer": "speed"|"quality"|null}\n'
        "Rules: 2-4 queries, each 1-3 words naming a model family or capability "
        "(e.g. 'qwen3 coder', 'codestral', 'devstral'). Set max_gb ONLY for an "
        "explicit size limit — 'small' means prefer=speed, not a byte budget.\n"
        "Request: " + q + "\nJSON only.")
    d = _json_blob(_ask_local(port, prompt, 400))
    if not d:
        return None
    queries = [str(x).strip() for x in (d.get("queries") or []) if str(x).strip()]
    queries = [x for x in queries if len(x) < 40][:4]
    cons: dict = {}
    if d.get("max_gb"):
        try:
            cons["max_bytes"] = int(float(d["max_gb"]) * 1000**3)
        except (TypeError, ValueError):
            pass
    if d.get("vision"):
        cons["vision"] = True
    if d.get("prefer") in ("speed", "quality"):
        cons["prefer"] = d["prefer"]
    return queries, cons


def llm_rerank(q: str, rows: "list[dict]", port: int) -> "dict | None":
    """Stage 2: judge a shortlist against the original request.

    This is where a local model actually earns its place — picking among concrete
    candidates it can see is a far easier task than inventing search keywords.
    """
    lines = []
    for i, r in enumerate(rows):
        tps = f"{r['tps']:.0f} tok/s" if r["tps"] else "unknown speed"
        flags = ",".join(filter(None, ["mtp" if r["mtp"] else "",
                                       "vision" if r["vision"] else "",
                                       "moe" if r["moe"] else ""])) or "dense"
        lines.append(f"{i}. {r['repo']} | {r['quant']} | {human(r['size'])} | "
                     f"{tps} | {flags} | {r['downloads']} downloads")
    prompt = ("Pick the best local models for this request:\n" + q + "\n\nCandidates:\n"
              + "\n".join(lines)
              + "\n\nRank them for the request. Judge suitability of the model family "
                "for the stated job, then speed and popularity. Ignore repos that are "
                "fine-tunes for an unrelated language or domain.\n"
                'Return JSON: {"order": [<indices best first, at most 8>], '
                '"reasons": {"<index>": "<max 9 words>"}}\nJSON only.')
    d = _json_blob(_ask_local(port, prompt, 900))
    if not d or not isinstance(d.get("order"), list):
        return None
    order, seen = [], set()
    for x in d["order"]:
        try:
            i = int(x)
        except (TypeError, ValueError):
            continue
        if 0 <= i < len(rows) and i not in seen:
            seen.add(i)
            order.append(i)
    if not order:
        return None
    reasons = {}
    for k, v in (d.get("reasons") or {}).items():
        try:
            reasons[int(k)] = str(v)[:60]
        except (TypeError, ValueError):
            continue
    return {"order": order, "reasons": reasons}


