def search_docker(terms: str, limit: int = 5) -> "list[dict]":
    """Docker Hub's curated ai/ namespace — what `llama-server -dr` pulls from."""
    cache = cache_root() / "docker_catalog.json"
    cat = None
    if cache.exists() and time.time() - cache.stat().st_mtime < 86400:
        try:
            cat = json.loads(cache.read_text())
        except json.JSONDecodeError:
            cat = None
    if cat is None:
        try:
            with urllib.request.urlopen(urllib.request.Request(
                    "https://hub.docker.com/v2/repositories/ai/?page_size=100",
                    headers=UA), timeout=20) as r:
                cat = json.load(r).get("results", [])
            cache.parent.mkdir(parents=True, exist_ok=True)
            cache.write_text(json.dumps(cat))
        except Exception:
            return []

    words = [w for w in terms.split() if len(w) > 2]
    hits = []
    for repo in cat:
        blob = (repo["name"] + " " + (repo.get("description") or "")).lower()
        if not words or any(w in blob for w in words):
            hits.append(repo)
    hits.sort(key=lambda r: r.get("pull_count", 0), reverse=True)
    return hits[:limit]


def docker_tags(name: str) -> "list[dict]":
    try:
        with urllib.request.urlopen(urllib.request.Request(
                f"https://hub.docker.com/v2/repositories/ai/{name}/tags?page_size=50",
                headers=UA), timeout=20) as r:
            return json.load(r).get("results", [])
    except Exception:
        return []


def enrich_repo(repo: str) -> "dict | None":
    """Fetch a repo's file tree and summarise its usable quants."""
    try:
        files = repo_files(repo)
    except SystemExit:
        return None
    except Exception:
        return None
    opts = {}
    for f in files:
        p = f["path"]
        if not p.lower().endswith(".gguf") or is_aux(p):
            continue
        q = quant_token(p)
        if not q:
            continue
        opts[q] = opts.get(q, 0) + f["size"]
    if not opts:
        return None
    return {"quants": opts,
            "mtp": pick_mtp(files) is not None,
            "vision": pick_mmproj(files) is not None}


FULL_PRECISION = re.compile(r"^(UD-)?(BF16|F16|F32)$", re.I)


def quant_bits(q: str) -> int:
    """Bits per weight, so Q2_K sorts below Q4_K_M rather than beside it."""
    if FULL_PRECISION.match(q):
        return 16
    m = re.search(r"(?:IQ|Q)(\d+)", q, re.I)
    return int(m.group(1)) if m else 0


def choose_quant(quants: dict, budget: int, prefer: str) -> "tuple[str, int] | None":
    fits = [(q, s) for q, s in quants.items() if s <= budget]
    if not fits:
        return None
    if prefer == "speed":
        # Cheapest option that is still 4-bit or better. Q2/Q3 are badly degraded
        # and are never the right answer to "fast".
        decent = [(q, s) for q, s in fits if quant_bits(q) >= 4]
        return min(decent or fits, key=lambda kv: kv[1])
    # "Best that fits" stops at Q8. F16/BF16 doubles the size and halves the speed
    # for no measurable quality gain over an 8-bit quant.
    capped = [(q, s) for q, s in fits if not FULL_PRECISION.match(q)]
    return max(capped or fits, key=lambda kv: kv[1])


# ------------------------------------------------------------------- commands

def ask(prompt: str, choices: str, default: str) -> str:
    """One-key prompt. Non-interactive callers get the default without blocking."""
    if not sys.stdin.isatty() or not sys.stderr.isatty():
        return default
    shown = "/".join(c.upper() if c == default else c for c in choices)
    while True:
        try:
            got = input(f"{prompt} [{shown}] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return "q"
        if not got:
            return default
        if got[0] in choices:
            return got[0]


def bytes_on_disk(repo: str, plan: "list[dict]") -> int:
    root = models_dir() / repo
    return sum((root / f["path"]).stat().st_size
               for f in plan if (root / f["path"]).exists())


def save_partial(name: str, repo: str, quant: str, plan: "list[dict]",
                 total: int) -> None:
    """Remember an unfinished pull so `list` can show it and `pull` can offer it."""
    reg = load_reg()
    reg.setdefault("partials", {})[name] = {
        "repo": repo, "quant": quant, "total": total,
        "done": bytes_on_disk(repo, plan),
        "files": [{"path": f["path"], "size": f["size"]} for f in plan],
        "updated": datetime.now(timezone.utc).isoformat(),
    }
    save_reg(reg)


def clear_partial(name: str) -> None:
    reg = load_reg()
    if reg.setdefault("partials", {}).pop(name, None) is not None:
        save_reg(reg)


def discard_partial(repo: str, plan: "list[dict]") -> int:
    root = models_dir() / repo
    freed = 0
    for f in plan:
        p = root / f["path"]
        if p.exists():
            freed += p.stat().st_size
            p.unlink()
    return freed


def cmd_pull(args: argparse.Namespace) -> None:
    reg = load_reg()
    repo, want = resolve_ref(args.model, reg, args.yes)
    info(f"{C.DIM}resolving {repo}:{want}{C.OFF}")
    files = repo_files(repo)

    weights = pick_weights(files, want)
    quant = quant_token(weights[0]["path"]) or want
    mtp = None if args.no_mtp else pick_mtp(files)
    mmproj = None if args.no_vision else pick_mmproj(files)

    plan = list(weights) + [f for f in (mtp, mmproj) if f]
    total = sum(f["size"] for f in plan)

    dest_dir = models_dir() / repo
    have = sum((dest_dir / f["path"]).stat().st_size
               for f in plan if (dest_dir / f["path"]).exists())
    need = max(total - have, 0)

    free = shutil.disk_usage(cache_root().parent if cache_root().exists()
                             else Path.home()).free
    name = short_name(repo, quant)
    info(f"{C.BOLD}{name}{C.OFF}  {human(total)}"
         + (f"  {C.DIM}({human(need)} to fetch){C.OFF}" if have else ""))
    for f in plan:
        tag = ""
        if mtp and f is mtp:
            tag = f"  {C.GRN}[MTP → ~2x decode]{C.OFF}"
        elif mmproj and f is mmproj:
            tag = f"  {C.BLU}[vision]{C.OFF}"
        info(f"  {C.DIM}·{C.OFF} {f['path']}  {C.DIM}{human(f['size'])}{C.OFF}{tag}")

    # An unfinished pull is resumable, but silently continuing a days-old partial
    # is surprising — say what is there and let the caller choose.
    if 0 < have < total:
        pct = have / total * 100
        prev = load_reg().get("partials", {}).get(name)
        when = f", interrupted {ago(prev['updated'])}" if prev else ""
        info(f"{C.YLW}partial download found{C.OFF}: "
             f"{human(have)} of {human(total)} ({pct:.1f}%){when}")
        choice = "r" if args.restart else ("y" if args.resume or args.yes else
                                           ask("  resume?", "yrq", "y"))
        if choice == "q":
            info("cancelled — nothing changed")
            return
        if choice == "r":
            freed = discard_partial(repo, plan)
            clear_partial(name)
            info(f"{C.DIM}discarded {human(freed)}, starting over{C.OFF}")
            have, need = 0, total

    if free - need < FREE_SPACE_FLOOR:
        die(f"not enough disk: {human(need)} needed, {human(free)} free "
            f"(keeping a {human(FREE_SPACE_FLOOR)} floor)")

    try:
        for f in plan:
            url = HF_RESOLVE.format(repo=repo, path=urllib.parse.quote(f["path"]))
            download(url, dest_dir / f["path"], f["size"], Path(f["path"]).name)
    except KeyboardInterrupt:
        save_partial(name, repo, quant, plan, total)
        got = bytes_on_disk(repo, plan)
        if _tty():
            sys.stderr.write("\r" + " " * 100 + "\r")
        info(f"\n{C.YLW}interrupted{C.OFF} — kept {human(got)} of {human(total)} "
             f"({got / total * 100:.1f}%)\n"
             f"  resume with: {C.BOLD}llcpp pull {repo}:{quant}{C.OFF}")
        sys.exit(130)
    except SystemExit:
        save_partial(name, repo, quant, plan, total)
        raise

    clear_partial(name)
    reg = load_reg()
    reg["models"][name] = {
        "repo": repo, "quant": quant, "dir": repo,
        "main": weights[0]["path"],
        "shards": [w["path"] for w in weights] if len(weights) > 1 else [],
        "mtp": mtp["path"] if mtp else None,
        "mmproj": mmproj["path"] if mmproj else None,
        "bytes": total,
        "pulled_at": datetime.now(timezone.utc).isoformat(),
    }
    save_reg(reg)
    info(f"{C.GRN}pulled{C.OFF} {C.BOLD}{name}{C.OFF} → llcpp run {name.split(':')[0]}")


def cmd_run(args: argparse.Namespace) -> None:
    reg = load_reg()
    name = _match_local(args.model, reg, autopull=True)
